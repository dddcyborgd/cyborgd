# /etc/cyborgd.env — every environment variable daemon/cyborgd.mjs reads (grep process.env daemon/).
# Copy to /etc/cyborgd.env, chmod 0640 root:deltaverse. Blank = the documented default.

# ── listen ──────────────────────────────────────────────────────────────────────────────────────
# 127.0.0.1 ONLY: Apache terminates TLS and proxies /cyborg/ws + /cyborg/api (ops/apache-cyborgd.conf).
CYBORGD_HOST=127.0.0.1
CYBORGD_PORT=8790

# ── identity: login333 ──────────────────────────────────────────────────────────────────────────
# The login333 issuer address (the DeltaVerse doorway's LOGIN333_SIGNER_KEY's address). UNSET → every
# claim is accepted UNVERIFIED, every response carries insecure:true and the log says so. Set it in production.
LOGIN333_ISSUER=0x0000000000000000000000000000000000000000

# ── the voucher signing key (ONE of the two forms) ──────────────────────────────────────────────
# a) a bankon-vault file (bankon-vault/1, sealed with a passphrase) — the production form
CYBORGD_VAULT=/home/deltaverse/dddcyborgd/cyborgd/state/signer.vault.json
CYBORGD_VAULT_PASSPHRASE=
# the entry id inside the vault holding the private key; blank = the first entry whose meta.format is "privateKey"
CYBORGD_VAULT_ENTRY=
# b) the raw hex key — development only, never on a VPS
#CYBORGD_SIGNER_KEY=0x…

# ── chains ──────────────────────────────────────────────────────────────────────────────────────
# RPC url per chain id (overrides registries/chains.json; enables a token whose registry entry is enabled:false)
RPC_1=https://ethereum-rpc.publicnode.com
RPC_16661=https://evmrpc.0g.ai
#RPC_16602=https://evmrpc-testnet.0g.ai
#RPC_5042002=
# CyborgFaucet address per chain (overrides the registry's predicted create3d address 0xfa0C63b5BD49a5eE2e725379D1728F0E966Ef199)
#CYBORG_FAUCET_1=
#CYBORG_FAUCET_16661=
# ShambaLuvAirdrop address on chain 1 (the LUV one-shot welcome; overrides 0xdf2C1836550c5711EF9c021cB0de86241dc1DEf3)
#LUV_AIRDROP=
# CyborgSpace (ERC-721) address per chain for tokenURI reads of "<chainId>:<tokenId>" spaces
#CYBORG_SPACE_16661=0x5ace4baEc5b9F80cDe517Ed42D51F360Eb52595e
# gateway for ipfs:// tokenURIs
#IPFS_GATEWAY=https://ipfs.io/ipfs/

# ── the daemon ──────────────────────────────────────────────────────────────────────────────────
# ledgers (faucet.jsonl, rooms.jsonl), counters.json and spaces/ — MUST match ReadWritePaths in the unit
CYBORGD_STATE_DIR=/home/deltaverse/dddcyborgd/cyborgd/state
# 1 = rooms run the deterministic sim lane (cmd/ack, authoritative); 0/unset = trusted state lane
CYBORGD_AUTHORITATIVE=0
# faucet hashcash difficulty in leading zero bits (default 21 ≈ a second or two in a browser worker)
#CYBORGD_POW_BITS=21
# an OpenAI-compatible /v1/chat/completions for non-riddle aivatar chat (blank = pattern replies only)
#CYBORGD_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# an explicit path to ethers.umd.min.js (blank = vendor/ethers/ethers.umd.min.js, then the DeltaVerse's copy)
#CYBORGD_ETHERS=
